rules_version = '2';

// Single-user app: only the owner can read or write, and only under users/{their uid}.
// Keep OWNER_UID in sync with src/lib/owner.ts (checked by src/lib/owner.test.ts).
// Rules guard security and System Accounts; bookkeeping rules live in src/lib/domain.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'nljVk7wwFdO2PFeKwZ1WwAdOn0J2';
    }

    match /users/{uid} {
      function accountPath(id) {
        return /databases/$(database)/documents/users/$(uid)/accounts/$(id);
      }

      match /accounts/{accountId} {
        function fields() {
          return ['name', 'description', 'type', 'parentId', 'system', 'archived', 'order', 'createdAt', 'updatedAt'];
        }
        function validShape(d) {
          return d.keys().hasOnly(fields().concat(['madeFrom'])) && d.keys().hasAll(fields())
            && (!('madeFrom' in d) || d.madeFrom == null
              || (d.madeFrom is string && d.madeFrom.size() >= 1))
            && d.name is string && d.description is string
            && d.type in ['asset', 'liability', 'equity', 'income', 'expense']
            && (d.parentId == null || d.parentId is string)
            && d.system in [null, 'root', 'opening-balances']
            && d.archived is bool && d.order is number
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }
        function isRootId() {
          return accountId in ['asset', 'liability', 'equity', 'income', 'expense'];
        }
        // System Accounts live at fixed IDs; any other Account sits under a parent of the same type.
        // getAfter: a parent created in the same batch counts.
        function validPlacement(d) {
          return (d.system == 'root' && isRootId() && d.parentId == null && d.type == accountId)
            || (d.system == 'opening-balances' && accountId == 'opening-balances'
                && d.parentId == 'equity' && d.type == 'equity')
            || (d.system == null && !isRootId() && accountId != 'opening-balances'
                && d.parentId is string && d.parentId != 'opening-balances'
                && existsAfter(accountPath(d.parentId))
                && getAfter(accountPath(d.parentId)).data.type == d.type);
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validShape(request.resource.data) && validPlacement(request.resource.data);
        // Root Accounts: description only. Opening Balances: locked. User Accounts: anything valid.
        allow update: if isOwner(uid)
          && validShape(request.resource.data) && validPlacement(request.resource.data)
          && (resource.data.system == null
              || (resource.data.system == 'root'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'updatedAt'])));
        allow delete: if isOwner(uid) && resource.data.system == null;
      }

      match /transactions/{txId} {
        // Shape only: bookkeeping rules (Entries sum to zero, Leaf Accounts, no future dates)
        // live in the domain module, which validates every write first.
        function required() {
          return ['date', 'origin', 'description', 'entries', 'accountIds', 'createdAt', 'updatedAt'];
        }
        // Added in v2; optional so documents written before them stay valid.
        function optional() {
          return ['note', 'status', 'tags', 'pays'];
        }
        function validTags(d) {
          return !('tags' in d) || (d.tags is list && d.tags.size() <= 50
            && d.tags.join(',').matches('^[a-z0-9,-]*$') && !d.tags.hasAny(['']));
        }
        function validTransaction(d) {
          return d.keys().hasAll(required()) && d.keys().hasOnly(required().concat(optional()))
            && d.origin in ['opening', 'normal']
            && (d.date == null || d.date is string)
            && d.description is string && d.description.size() >= 1 && d.description.size() <= 200
            && d.entries is list && d.entries.size() >= 2 && d.entries.size() <= 100
            && d.accountIds is list
            && (!('note' in d) || (d.note is string && d.note.size() <= 5000))
            && (!('status' in d) || d.status in ['cleared', 'pending'])
            && validTags(d)
            && (!('pays' in d) || d.pays == null || d.pays is map)
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTransaction(request.resource.data);
      }

      // Scheduled Transactions (ADR 0003). Shape only at the top level; versions, lines and
      // rules are checked by the domain module's Zod schema before every write.
      match /scheduled/{planId} {
        function fields() {
          return ['versions', 'end', 'occurrences', 'createdAt', 'updatedAt'];
        }
        function validPlan(d) {
          return d.keys().hasOnly(fields().concat(['madeFrom'])) && d.keys().hasAll(fields())
            && (!('madeFrom' in d) || d.madeFrom == null
              || (d.madeFrom is string && d.madeFrom.size() >= 1))
            && d.versions is list && d.versions.size() >= 1 && d.versions.size() <= 100
            && d.end is map && d.occurrences is map
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlan(request.resource.data);
      }

      // Installment Plans (ADR 0004). Shape only at the top level; rows, Accounts and
      // bookkeeping are checked by the domain module and its Zod schema before every write.
      match /installments/{planId} {
        function fields() {
          return ['kind', 'title', 'note', 'tags', 'purchaseDate', 'entry', 'rule', 'trackedFrom',
            'accounts', 'rows', 'createdAt', 'updatedAt'];
        }
        function validInstallment(d) {
          return d.keys().hasOnly(fields().concat(['madeFrom'])) && d.keys().hasAll(fields())
            && (!('madeFrom' in d) || d.madeFrom == null
              || (d.madeFrom is string && d.madeFrom.size() >= 1))
            && d.kind in ['lender', 'internal']
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
            && d.note is string && d.note.size() <= 5000
            && d.tags is list && d.tags.size() <= 50
            && d.purchaseDate is string
            && d.entry in ['flat', 'varied']
            && d.rule is map
            && d.trackedFrom is int
            && d.accounts is map
            && d.rows is list && d.rows.size() >= 1 && d.rows.size() <= 600
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validInstallment(request.resource.data);
      }
    }

    // Everything else falls through to deny.
  }
}
